      <groupId>nuxeo.labs.images.dup</groupId>
      <artifactId>nuxeo-labs-images-dup-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.elasticsearch9</groupId>
      <artifactId>nuxeo-search-client-elasticsearch9</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
