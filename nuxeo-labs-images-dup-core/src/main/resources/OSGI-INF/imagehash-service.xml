<?xml version="1.0"?>
<component name="nuxeo.labs.images.dup.ImageHashService">

  <documentation>
    Computes a perceptual hash (pHash, 64 bits) of Picture documents and finds near duplicates using NXQL.
  </documentation>

  <implementation class="nuxeo.labs.images.dup.ImageHashServiceImpl" />

  <service>
    <provide interface="nuxeo.labs.images.dup.ImageHashService" />
  </service>

  <extension-point name="configuration">
    <documentation>
      Every element is optional, contributions are merged. Default values:
      <code>
        <configuration>
          <!-- First available picture view is hashed. Changing the first view changes the signature:
               existing hashes are ignored until recomputed (bulk action "computeImageHash") -->
          <views>
            <view>Small</view>
            <view>Medium</view>
            <view>FullHD</view>
            <view>OriginalJpeg</view>
          </views>
          <!-- Max Hamming distance (out of 64 bits) for 2 images to be considered duplicates -->
          <threshold>8</threshold>
          <!-- Detection after picture views generation. Radius (0-2) per 16-bit band: all images within
               a distance of 3 (radius 0), 7 (radius 1) or 11 (radius 2) are guaranteed to be found -->
          <detectionRadius>1</detectionRadius>
          <!-- Also detect rotated (90/180/270) and mirrored images -->
          <detectionOrientations>false</detectionOrientations>
          <!-- Same, for the ImageHash.FindSimilar operation -->
          <searchRadius>1</searchRadius>
          <searchOrientations>true</searchOrientations>
          <!-- Max candidates fetched per search (must not exceed the search index max result window) -->
          <maxCandidates>10000</maxCandidates>
        </configuration>
      </code>
    </documentation>
    <object class="nuxeo.labs.images.dup.ImageHashConfigurationDescriptor" />
  </extension-point>

</component>
