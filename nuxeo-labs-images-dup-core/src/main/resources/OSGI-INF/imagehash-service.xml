<?xml version="1.0"?>
<component name="nuxeo.labs.images.dup.ImageHashService">

  <documentation>
    Computes a perceptual hash (pHash, 64 bits) of Picture documents and finds near duplicates using NXQL.
  </documentation>

  <implementation class="nuxeo.labs.images.dup.ImageHashServiceImpl" />

  <service>
    <provide interface="nuxeo.labs.images.dup.ImageHashService" />
  </service>

  <extension-point name="configuration">
    <documentation>
      Every element is optional, contributions are merged. Default values:
      <code>
        <configuration>
          <!-- The first readable view of the list is hashed, looked up by name. A contribution replaces
               the whole list, and a picture with none of the listed views is not hashed. Keep first a view
               of 256 to 512 pixels on its smaller side, such as Small: larger ones only cost decoding time.
               Changing this list does not invalidate the existing hashes, but the same image hashed from
               views of different sizes gets hashes a few bits apart -->
          <views>
            <view>Small</view>
            <view>Medium</view>
            <view>FullHD</view>
            <view>OriginalJpeg</view>
          </views>
          <!-- Max Hamming distance (out of 64 bits) for 2 images to be considered duplicates.
               Keep it close to 4 * radius + 3 (3, 7 or 11): beyond that distance a pair is found
               only by luck, so raising the threshold alone widens what is accepted, not what is found -->
          <threshold>8</threshold>
          <!-- Detection after picture views generation. Set to false to only store the hash, for instance
               during a mass import, then detect with the bulk action "detectImageDuplicates" -->
          <detectionEnabled>true</detectionEnabled>
          <!-- Radius (0-2) per 16-bit band of that detection, and of the bulk action: all images within
               a distance of 3 (radius 0), 7 (radius 1) or 11 (radius 2) are guaranteed to be found -->
          <detectionRadius>1</detectionRadius>
          <!-- Also detect rotated (90/180/270) and mirrored images -->
          <detectionOrientations>false</detectionOrientations>
          <!-- Same, for the ImageHash.FindSimilar operation, the Similar Images tab and its page provider.
               Also the most a user who is not an administrator can ask for -->
          <searchRadius>1</searchRadius>
          <searchOrientations>true</searchOrientations>
          <!-- Max documents fetched per search query (must not exceed the search index max result window):
               the matches when the search engine computes the distance, otherwise the candidates -->
          <maxCandidates>10000</maxCandidates>
        </configuration>
      </code>
    </documentation>
    <object class="nuxeo.labs.images.dup.ImageHashConfigurationDescriptor" />
  </extension-point>

</component>
