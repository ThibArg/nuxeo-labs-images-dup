<!-- See documentation at http://doc.nuxeo.com/x/HgIz -->
<package type="addon" name="nuxeo-labs-images-dup" version="@VERSION@">
  <title>Nuxeo Labs Images Duplicates</title>
  <description>
    <p>Detects near-duplicate images (documents with the Picture facet) using a perceptual hash (pHash).
    Hashes are computed after picture views generation, stored on the document and searched with NXQL,
    so results always honor permissions. A "duplicatedImage" event is fired when near duplicates are found.</p>
    <p>With Web UI, Picture documents get a "Similar Images" tab listing their near duplicates.</p>
  </description>
  <vendor>Hyland</vendor>
  <installer restart="true" />
  <uninstaller restart="true" />
  <nuxeo-validation>none</nuxeo-validation>
  <production-state>testing</production-state>
  <supported>false</supported>
  <target-platform>
    <name>lts</name>
    <version>[@NUXEO_TARGET_VERSION@,)</version>
  </target-platform>
  <!-- The "Similar Images" tab needs Web UI, the rest of the plugin does not -->
  <optional-dependencies>
    <package>nuxeo-web-ui</package>
  </optional-dependencies>
  <!-- A search engine client is required, but any of nuxeo-search-client-opensearch1,
       nuxeo-search-client-opensearch2 or nuxeo-search-client-elasticsearch9 will do, and the
       package format cannot express alternatives. See the README. -->
  <license>Apache License, Version 2.0</license>
  <license-url>http://www.apache.org/licenses/LICENSE-2.0</license-url>
  <visibility>DEV</visibility>
</package>
