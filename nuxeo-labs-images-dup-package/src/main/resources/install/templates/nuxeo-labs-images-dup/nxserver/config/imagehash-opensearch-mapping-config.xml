<?xml version="1.0"?>
<component name="nuxeo.labs.images.dup.opensearch.mapping">

  <!--
    The band keys are opaque search keys. The default dynamic mapping indexes every string with
    copy_to="all_field", which would push them into the fulltext field and make them match fulltext
    searches. An explicit property mapping takes precedence over the dynamic template and drops copy_to,
    while keeping the field queryable as a keyword.

    This must be merged after the base mapping: OpenSearchIndexConfig.merge() only preserves the base
    content when the INCOMING descriptor is the appending one, so the ordering below is required.

    The mapping is applied when the index is created. On an existing index, drop it and reindex.
  -->
  <require>org.nuxeo.ecm.core.search.client.opensearch1.contrib</require>

  <extension target="org.nuxeo.runtime.opensearch1.OpenSearchComponent" point="index">
    <index name="${nuxeo.search.client.default.opensearch1.index.name}">
      <mapping append="true">
        {
          "properties": {
            "imgh:bands": {
              "type": "keyword",
              "ignore_above": 32
            }
          }
        }
      </mapping>
    </index>
  </extension>

</component>
