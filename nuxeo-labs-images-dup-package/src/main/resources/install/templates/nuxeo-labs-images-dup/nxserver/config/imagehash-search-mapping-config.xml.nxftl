<#escape x as x?xml>
<?xml version="1.0"?>
<component name="nuxeo.labs.images.dup.search.mapping">

  <!--
    The three properties of the imagehash schema are technical strings: imgh:bands holds opaque
    search keys, imgh:phash the hash in hexadecimal and imgh:signature the version of the hash
    algorithm, the same on every picture. The default dynamic mapping indexes every string with
    copy_to="all_field", which pushes them into the fulltext field and makes them match fulltext
    searches: a search for the signature returns every hashed picture. An explicit property mapping
    takes precedence over the dynamic template and drops copy_to, while keeping the field queryable
    as a keyword. imgh:phash and imgh:signature keep the ignore_above of the dynamic template.

    The mapping is written once, in the macro below. The test contribution of the core module
    (test-opensearch-mapping-contrib.xml) is its copy for the tests, keep it identical.

    One macro call per index of each search client, guarded by its index name property. A stack that is not
    installed emits neither its <require> nor its <extension>, so the component still resolves;
    with no search engine at all this renders an empty, inert component. Only one of OpenSearch 1
    and OpenSearch 2 can ever be installed, they declare <conflicts> on each other, but OpenSearch 1
    and Elasticsearch 9 do coexist during a migration, so several blocks may render at once.

    Ordering matters: IndexConfig.merge() preserves the base mapping only when the INCOMING
    descriptor is the appending one, hence the <require> on the component holding it.

    Mappings apply at index creation. On an existing index, drop it and reindex. The green blocks
    cover a blue/green reindex, where the green index is created fresh and would otherwise be built
    polluted.
  -->

<#--
  One search index of one search client. indexName is empty when the client is not installed or
  has no such index, and nothing is emitted then. The <require> is part of it: see "Ordering
  matters" above.
-->
<#macro mapping indexName require target>
<#if indexName?has_content>
  <require>${require}</require>

  <extension target="${target}" point="index">
    <index name="${indexName}">
      <mapping append="true">
        {
          "properties": {
            "imgh:bands": {
              "type": "keyword",
              "ignore_above": 32
            },
            "imgh:phash": {
              "type": "keyword",
              "ignore_above": 256
            },
            "imgh:signature": {
              "type": "keyword",
              "ignore_above": 256
            }
          }
        }
      </mapping>
    </index>
  </extension>
</#if>
</#macro>

  <!-- OpenSearch 1.x, Elasticsearch 7.x-8.x -->
<@mapping indexName=((nuxeo.search.client.default.opensearch1.index.name)!)
  require="org.nuxeo.ecm.core.search.client.opensearch1.contrib"
  target="org.nuxeo.runtime.opensearch1.OpenSearchComponent" />
<@mapping indexName=((nuxeo.search.client.green.opensearch1.index.name)!)
  require="org.nuxeo.ecm.core.search.client.opensearch1.green.contrib"
  target="org.nuxeo.runtime.opensearch1.OpenSearchComponent" />

  <!-- OpenSearch 2.x -->
<@mapping indexName=((nuxeo.search.client.default.opensearch2.index.name)!)
  require="org.nuxeo.ecm.core.search.client.opensearch2.contrib"
  target="org.nuxeo.runtime.opensearch2.OpenSearchComponent" />
<@mapping indexName=((nuxeo.search.client.green.opensearch2.index.name)!)
  require="org.nuxeo.ecm.core.search.client.opensearch2.green.contrib"
  target="org.nuxeo.runtime.opensearch2.OpenSearchComponent" />

  <!-- Elasticsearch 9.x -->
<@mapping indexName=((nuxeo.search.client.default.elasticsearch9.index.name)!)
  require="org.nuxeo.ecm.core.search.client.elasticsearch9.contrib"
  target="org.nuxeo.runtime.elasticsearch9.ElasticsearchComponent" />
<@mapping indexName=((nuxeo.search.client.green.elasticsearch9.index.name)!)
  require="org.nuxeo.ecm.core.search.client.elasticsearch9.green.contrib"
  target="org.nuxeo.runtime.elasticsearch9.ElasticsearchComponent" />

</component>
</#escape>
