## DO NOT EDIT THIS FILE, USE nuxeo.conf ##
nuxeo-labs-images-dup.target=.

## Keep imgh:bands out of the repository fulltext index.
## Set to false to disable, and set the repository name if yours is not "default".
nuxeo.labs.images.dup.fulltext.exclude=true
nuxeo.labs.images.dup.fulltext.repository=default
